APP_NAME=My Farm Grow
DEBUG=false

# Copy this file to .env and replace both values.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/myfarmgrows
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Razorpay. Online payment is offered only when the key id and
# secret are set. Use test keys (rzp_test_...) until the flow is tested.
# The webhook secret must match the one set in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=test@example.com

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: shown under the store name on order receipts.
BUSINESS_ADDRESS=
BUSINESS_PHONE=
